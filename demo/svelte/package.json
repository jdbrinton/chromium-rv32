{
  "name": "chromium-rv32-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Svelte 5 demo app + Node server. Validates hydration, DOM updates, event handling, fetch, and streamed (SSE) data in the chromium-rv32 runtime.",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "vite": "^8.0.7"
  }
}
