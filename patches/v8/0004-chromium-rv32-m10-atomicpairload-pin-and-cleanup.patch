+// chromium-rv32 M10: choose BInt and the 64-bit-atomic CSA types based on the
+// *target* arch, not the host. Upstream uses V8_HOST_ARCH_32_BIT here, which
+// for v8's official bot matrix happens to coincide with V8_TARGET_ARCH_32_BIT
+// (host bitness == target bitness for every supported cross-compile). For
+// chromium-rv32 our build runs an x86_64 host but cross-targets RV32, *and*
+// the v8 mksnapshot binary is itself built as a 32-bit i386 host binary (so
+// V8_HOST_ARCH_32_BIT does still happen to be true during mksnapshot's own
+// compile pass) -- but a 64-bit-host-cross-RV32 build would silently fall
+// off the BINT_IS_SMI path and emit Word64 BigInt-from-int64 calls in CSA
+// builtins like Atomics.load. Switch to V8_TARGET_ARCH_32_BIT to make the
+// type choice match the eventual generated code regardless of the host the
+// mksnapshot toolchain happens to use.
+#if defined(V8_TARGET_ARCH_32_BIT)
 #define BINT_IS_SMI
 using BInt = Smi;
 using AtomicInt64 = PairT<IntPtrT, IntPtrT>;
 using AtomicUint64 = PairT<UintPtrT, UintPtrT>;
-#elif defined(V8_HOST_ARCH_64_BIT)
+#elif defined(V8_TARGET_ARCH_64_BIT)
