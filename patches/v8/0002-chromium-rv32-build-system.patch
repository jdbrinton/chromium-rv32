From: chromium-rv32
Subject: [PATCH] chromium-rv32 RV32 build-system patches

Applied to v8/build (a separate git submodule), targets the commit
  be09d50c38a902bf3ec39da64ff3773034b746fc
(matching v8 DEPS at the Option C pinned V8 commit).

Adds riscv32 awareness to: rust target lookup, clang compiler-rt
lookup, --target= and -march/-mabi compiler flags, GN toolchain
blocks for the bundled clang (riscv32 + clang_x86_v8_riscv32 +
clang_x64_v8_riscv32) and the gcc fallback (riscv32-linux-gnu-*),
and a runtime -latomic addition for default_libs because the
RV32A extension only provides 32-bit atomics.

----

diff --git a/config/BUILD.gn b/config/BUILD.gn
index 96085b4..6906ce0 100644
--- a/config/BUILD.gn
+++ b/config/BUILD.gn
@@ -215,6 +215,12 @@ config("default_libs") {
       "pthread",
       "rt",
     ]
+    if (current_cpu == "riscv32") {
+      # chromium-rv32 patch: RV32A only provides 32-bit atomics. gcc/clang
+      # lower 64-bit __atomic_* builtins to libcalls that live in libatomic
+      # (built by gcc, copied into the sysroot from buildroot output).
+      libs += [ "atomic" ]
+    }
   }
 }
 
diff --git a/config/clang/BUILD.gn b/config/clang/BUILD.gn
index d49f0ec..cbdf815 100644
--- a/config/clang/BUILD.gn
+++ b/config/clang/BUILD.gn
@@ -190,6 +190,9 @@ template("clang_lib") {
           _dir = "loongarch64-unknown-linux-gnu"
         } else if (current_cpu == "riscv64") {
           _dir = "riscv64-unknown-linux-gnu"
+        } else if (current_cpu == "riscv32") {
+          # chromium-rv32 patch
+          _dir = "riscv32-unknown-linux-gnu"
         } else if (current_cpu == "ppc64") {
           _dir = "ppc64le-unknown-linux-gnu"
         } else if (current_cpu == "s390x") {
diff --git a/config/compiler/BUILD.gn b/config/compiler/BUILD.gn
index 0483b93..0a1e1fa 100644
--- a/config/compiler/BUILD.gn
+++ b/config/compiler/BUILD.gn
@@ -1583,6 +1583,16 @@ config("compiler_cpu_abi") {
         ldflags += [ "--target=riscv64-linux-gnu" ]
       }
       cflags += [ "-mabi=lp64d" ]
+    } else if (current_cpu == "riscv32") {
+      # chromium-rv32 patch: target rv32gc with the ilp32d ABI.
+      if (is_clang && !is_android) {
+        cflags += [ "--target=riscv32-linux-gnu" ]
+        ldflags += [ "--target=riscv32-linux-gnu" ]
+      }
+      cflags += [
+        "-march=rv32gc",
+        "-mabi=ilp32d",
+      ]
     } else if (current_cpu == "loong64") {
       if (is_clang) {
         cflags += [ "--target=loongarch64-linux-gnu" ]
diff --git a/config/rust.gni b/config/rust.gni
index ef45a4a..145c6f9 100644
--- a/config/rust.gni
+++ b/config/rust.gni
@@ -217,6 +217,9 @@ if (is_linux || is_chromeos) {
     }
   } else if (current_cpu == "riscv64") {
     rust_abi_target = "riscv64gc-unknown-linux-gnu"
+  } else if (current_cpu == "riscv32") {
+    # chromium-rv32 patch
+    rust_abi_target = "riscv32gc-unknown-linux-gnu"
   } else if (current_cpu == "ppc64") {
     rust_abi_target = "powerpc64le-unknown-linux-gnu"
   } else if (current_cpu == "s390x") {
@@ -375,6 +378,9 @@ if (current_cpu == "x86") {
   rust_target_arch = "powerpc64"
 } else if (current_cpu == "riscv64") {
   rust_target_arch = "riscv64"
+} else if (current_cpu == "riscv32") {
+  # chromium-rv32 patch
+  rust_target_arch = "riscv32"
 } else if (current_cpu == "loong64") {
   rust_target_arch = "loongarch64"
 }
diff --git a/rust/known-target-triples.txt b/rust/known-target-triples.txt
index fc4780b..3fc39c6 100644
--- a/rust/known-target-triples.txt
+++ b/rust/known-target-triples.txt
@@ -29,6 +29,7 @@ i686-linux-android
 i686-pc-windows-msvc
 i686-unknown-linux-gnu
 loongarch64-unknown-linux-gnu
+riscv32gc-unknown-linux-gnu
 riscv64-linux-android
 riscv64gc-unknown-linux-gnu
 thumbv7neon-linux-androideabi
diff --git a/toolchain/linux/BUILD.gn b/toolchain/linux/BUILD.gn
index a6e20a0..2c0b2cc 100644
--- a/toolchain/linux/BUILD.gn
+++ b/toolchain/linux/BUILD.gn
@@ -144,6 +144,15 @@ clang_v8_toolchain("clang_x86_v8_mips") {
   }
 }
 
+# chromium-rv32 patch: V8 host tools (torque/mksnapshot/etc.) built as x86
+# (32-bit pointers) so the snapshot they emit matches the riscv32 target.
+clang_v8_toolchain("clang_x86_v8_riscv32") {
+  toolchain_args = {
+    current_cpu = "x86"
+    v8_current_cpu = "riscv32"
+  }
+}
+
 clang_v8_toolchain("clang_x64_v8_arm64") {
   toolchain_args = {
     current_cpu = "x64"
@@ -172,6 +181,14 @@ clang_v8_toolchain("clang_x64_v8_riscv64") {
   }
 }
 
+# chromium-rv32 patch: V8 simulator on x64 host targeting riscv32 instructions.
+clang_v8_toolchain("clang_x64_v8_riscv32") {
+  toolchain_args = {
+    current_cpu = "x64"
+    v8_current_cpu = "riscv32"
+  }
+}
+
 clang_v8_toolchain("clang_x64_v8_loong64") {
   toolchain_args = {
     current_cpu = "x64"
@@ -266,6 +283,35 @@ clang_toolchain("clang_riscv64") {
   }
 }
 
+# chromium-rv32 patch: native rv32 cross with bundled clang.
+clang_toolchain("clang_riscv32") {
+  enable_linker_map = true
+  toolchain_args = {
+    current_cpu = "riscv32"
+    current_os = "linux"
+    is_clang = true
+  }
+}
+
+# chromium-rv32 patch: fallback to a system gcc cross (riscv32-linux-gnu-*).
+gcc_toolchain("riscv32") {
+  toolprefix = "riscv32-linux-gnu"
+
+  cc = "${toolprefix}-gcc"
+  cxx = "${toolprefix}-g++"
+
+  readelf = "${toolprefix}-readelf"
+  nm = "${toolprefix}-nm"
+  ar = "${toolprefix}-ar"
+  ld = cxx
+
+  toolchain_args = {
+    current_cpu = "riscv32"
+    current_os = "linux"
+    is_clang = false
+  }
+}
+
 gcc_toolchain("riscv64") {
   toolprefix = "riscv64-linux-gnu"
 
