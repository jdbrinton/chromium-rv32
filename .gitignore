# chromium-rv32 — keep the repo source-light.
#
# Everything below is either an upstream checkout we pin elsewhere, a
# build artefact reproducible from the scripts, or a runtime log.
# If you find yourself wanting to commit one of these, write a script
# that regenerates it instead.

# ---------------------------------------------------------------------------
# Upstream source trees (fetched by scripts/fetch-sources.sh)
# ---------------------------------------------------------------------------
/src/
/src/**/

# ---------------------------------------------------------------------------
# Toolchain + Buildroot output (built by scripts/build-sysroot.sh and
# scripts/build-guest.sh; both products are huge and 100 % reproducible
# from configs/buildroot/ + the pinned upstream tarballs)
# ---------------------------------------------------------------------------
/toolchain/
/toolchain/**/

# ---------------------------------------------------------------------------
# Out-of-tree build directories (gn gen + ninja outputs for V8 d8 and
# Chromium content_shell). Anything inside /build/ can be regenerated by
# re-running the corresponding scripts/build-*.sh script.
# ---------------------------------------------------------------------------
/build/
/build/**/

# ---------------------------------------------------------------------------
# QEMU guest images + rootfs payloads
# ---------------------------------------------------------------------------
*.cpio
*.cpio.gz
*.ext4
*.img
*.iso
*.qcow2
/configs/buildroot/staged-rootfs/
/configs/buildroot/staged-rootfs/**/

# ---------------------------------------------------------------------------
# Logs + run-time scratch
# ---------------------------------------------------------------------------
*.log
/logs/
/logs/**/
/tmp/
/tmp/**/

# ---------------------------------------------------------------------------
# Node / Svelte demo
# ---------------------------------------------------------------------------
node_modules/
/demo/svelte/.svelte-kit/
/demo/svelte/build/
/demo/svelte/.env
/demo/svelte/.env.*
/demo/svelte/*.tgz
/demo/svelte/npm-debug.log*
/demo/svelte/yarn-error.log*

# ---------------------------------------------------------------------------
# Python helpers (tools/*.py)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/

# ---------------------------------------------------------------------------
# ccache (host-side compile cache; large, regeneratable)
# ---------------------------------------------------------------------------
/ccache/
/ccache/**/

# ---------------------------------------------------------------------------
# Artefacts directory — curated examples only.
# Anything generated by a run-on-demand script lands here at runtime and
# should NOT be committed.
# ---------------------------------------------------------------------------
/artifacts/runs/
/artifacts/runs/**/
/artifacts/*.cpio.gz
/artifacts/*.ext4
/artifacts/*.bin
/artifacts/*.cap
# Reject every PNG inside artifacts/ by default; whitelist the curated
# examples below. Add new committed examples by negating them
# explicitly.
/artifacts/*.png
!/artifacts/example-m6-all-green.png
!/artifacts/example-m7-click-proof.png

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
.netrwhist

# ---------------------------------------------------------------------------
# Git bundles (large; used as offline-restore artefacts, not committed)
# ---------------------------------------------------------------------------
*.bundle
