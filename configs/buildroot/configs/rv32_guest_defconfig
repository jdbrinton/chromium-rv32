# Buildroot config for a bootable rv32 Linux guest that boots into a
# busybox userspace with V8's d8 baked in. The cross toolchain matches
# the one rv32_sysroot_defconfig produces, so the d8 we build against
# that sysroot runs unmodified inside this guest.
#
# Use with:
#   make BR2_EXTERNAL=$(realpath configs/buildroot) \
#        O=toolchain/buildroot-guest \
#        rv32_guest_defconfig
#   make BR2_EXTERNAL=$(realpath configs/buildroot) O=toolchain/buildroot-guest
#
# (scripts/build-guest.sh wraps this. The script also creates an empty
# directory at configs/buildroot/staged-rootfs/ if scripts/install-
# content-shell-in-rootfs.sh has not been run yet, so the overlay stack
# below resolves cleanly.)

# --- target architecture (matches rv32_sysroot_defconfig) ---
BR2_riscv=y
BR2_RISCV_32=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVC=y

# --- toolchain ---
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_GENERATE_LOCALE="en_US.UTF-8"

# --- userspace ---
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# --- d8 runtime deps ---
# libatomic is needed by d8 (RV32A has no 64-bit atomics); libgcc/libm/libc
# are pulled in by the toolchain.

# --- rootfs ---
# Buildroot applies overlays in order and lays them on top of target/.
# Three layers (left-to-right precedence):
#   1) M2 d8 overlay     — busybox init.d hook S99-run-d8.
#   2) M5 chromium       — static init.d hooks S97-mount-chromium-rootfs
#                          and S98-run-content-shell-m5, plus the
#                          /usr/local/share/m5-content-shell/m5-acceptance.sh
#                          script.
#   3) M5 staged tree    — generated by scripts/install-content-shell-in-rootfs.sh
#                          into $(BR2_EXTERNAL_CHROMIUM_RV32_PATH)/staged-rootfs/.
#                          Contains a launcher wrapper at /usr/local/bin/content_shell,
#                          a mountpoint stub at /usr/local/chromium/, and the
#                          Svelte 5 dist at /usr/local/share/svelte-demo/.
#                          Generated; gitignored. scripts/build-guest.sh
#                          creates the directory empty when missing so
#                          this stack still resolves.
#
# The bulk of the chromium payload (content_shell ELF + ~400 transitive
# .so closure + Chromium resource paks, ~417 MB) does NOT live in the
# cpio. It is packaged separately as a chromium-rootfs.ext4 image
# (also generated by scripts/install-content-shell-in-rootfs.sh) and
# attached to qemu-system-riscv32 as a virtio-blk device. The rv32 Linux
# 6.18 kernel's lowmem ceiling (~768 MB usable on the QEMU virt board
# with sv32 paging) is too small for that much rootfs.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CHROMIUM_RV32_PATH)/board/rv32-d8/rootfs-overlay $(BR2_EXTERNAL_CHROMIUM_RV32_PATH)/board/rv32-chromium/rootfs-overlay $(BR2_EXTERNAL_CHROMIUM_RV32_PATH)/staged-rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CHROMIUM_RV32_PATH)/board/rv32-d8/post-build.sh"

# initramfs (gzip cpio) keeps the boot cmdline simple: -kernel + -initrd.
# Image size with d8 + glibc + libstdc++ is ~30 MB compressed.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# --- kernel ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_DEFCONFIG="rv32"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CHROMIUM_RV32_PATH)/board/rv32-d8/linux.fragment"
BR2_LINUX_KERNEL_IMAGE=y

# --- firmware ---
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION_VALUE="1.6"
BR2_TARGET_OPENSBI_PLAT="generic"

# --- host tools ---
# qemu-system-riscv32 for running the guest, qemu-user-riscv32 for the
# M1 user-mode smoke test path (so both M1 and M2 work from a single
# buildroot tree).
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
BR2_PACKAGE_HOST_QEMU_LINUX_USER_MODE=y
